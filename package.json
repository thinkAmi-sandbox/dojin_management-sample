    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.2",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
