# Database
DATABASE_URL=postgresql://dojin_user:dojin_password@localhost:15432/dojin_management
DATABASE_URL_TEST=postgresql://dojin_user:dojin_password@localhost:15432/dojin_management_test

# PostgreSQL (for Docker Compose)
POSTGRES_USER=dojin_user
POSTGRES_PASSWORD=dojin_password
POSTGRES_DB=dojin_management

# Application
PORT=3000
NODE_ENV=development

# NestJS-PinoによるLoggingLogging
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

# 環境別の推奨設定
#開発環境:
#NODE_ENV=development
#LOG_LEVEL=debug
#LOG_PRETTY_PRINT=true
#
#本番環境:
#NODE_ENV=production
#LOG_LEVEL=info
#LOG_PRETTY_PRINT=false
#
#テスト環境:
#NODE_ENV=test
#LOG_LEVEL=silent
#LOG_PRETTY_PRINT=false