<style>
    .header { margin-bottom: 20px; }
    .actions { margin-bottom: 20px; }
    .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; }
    .btn:hover { background: #0056b3; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    .actions-cell { white-space: nowrap; }
    .action-link { margin-right: 8px; text-decoration: none; }
    .empty-message { text-align: center; padding: 40px; color: #666; }
    .date-cell { white-space: nowrap; }
    .email-cell { max-width: 200px; overflow: hidden; text-overflow: ellipsis; }
</style>

<div class="header">
    <h1><%= title %></h1>
</div>

<div class="actions">
    <a href="/circles/new" class="btn">新規登録</a>
</div>

<% if (circles.length > 0) { %>
    <table>
        <thead>
            <tr>
                <th>サークル名</th>
                <th>代表者名</th>
                <th>メールアドレス</th>
                <th>登録日</th>
                <th>説明</th>
                <th>アクション</th>
            </tr>
        </thead>
        <tbody>
            <% circles.forEach(circle => { %>
                <tr>
                    <td><%= circle.name %></td>
                    <td><%= circle.representativeName %></td>
                    <td class="email-cell" title="<%= circle.email %>"><%= circle.email %></td>
                    <td class="date-cell"><%= circle.formattedCreatedAt %></td>
                    <td title="<%= circle.fullDescription %>"><%= circle.description %></td>
                    <td class="actions-cell">
                        <a href="/circles/<%= circle.id %>" class="action-link">詳細</a>
                        <a href="/circles/<%= circle.id %>/edit" class="action-link">編集</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <div class="empty-message">
        <p>サークルが登録されていません。</p>
        <a href="/circles/new" class="btn">最初のサークルを登録する</a>
    </div>
<% } %>