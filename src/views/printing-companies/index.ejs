<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .header { margin-bottom: 20px; }
        .actions { margin-bottom: 20px; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; }
        .btn:hover { background: #0056b3; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .actions-cell { white-space: nowrap; }
        .action-link { margin-right: 8px; text-decoration: none; }
        .empty-message { text-align: center; padding: 40px; color: #666; }
        .website-link { color: #007bff; text-decoration: none; }
        .website-link:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
    </div>

    <div class="actions">
        <a href="/printing-companies/new" class="btn">新規登録</a>
    </div>

    <% if (printingCompanies.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>印刷所名</th>
                    <th>公式サイト</th>
                    <th>備考</th>
                    <th>アクション</th>
                </tr>
            </thead>
            <tbody>
                <% printingCompanies.forEach(company => { %>
                    <tr>
                        <td><%= company.name %></td>
                        <td>
                            <% if (company.websiteUrl) { %>
                                <a href="<%= company.websiteUrl %>" target="_blank" class="website-link">
                                    <%= company.websiteUrl %>
                                </a>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td title="<%= company.fullNotes %>"><%= company.notes %></td>
                        <td class="actions-cell">
                            <a href="/printing-companies/<%= company.id %>" class="action-link">詳細</a>
                            <a href="/printing-companies/<%= company.id %>/edit" class="action-link">編集</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-message">
            <p>印刷所が登録されていません。</p>
            <a href="/printing-companies/new" class="btn">最初の印刷所を登録する</a>
        </div>
    <% } %>
</body>
</html>