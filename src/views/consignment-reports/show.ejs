<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; line-height: 1.6; }
        .container { max-width: 900px; margin: 0 auto; }
        .header { margin-bottom: 20px; }
        .actions { margin-bottom: 20px; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; margin-right: 8px; border: none; cursor: pointer; }
        .btn:hover { background: #0056b3; }
        .btn-secondary { background: #6c757d; }
        .btn-secondary:hover { background: #5a6268; }
        .btn-success { background: #28a745; }
        .btn-success:hover { background: #218838; }
        .btn-warning { background: #ffc107; color: #212529; }
        .btn-warning:hover { background: #e0a800; }
        .btn-primary { background: #007bff; }
        .btn-primary:hover { background: #0056b3; }
        
        .detail-section { margin-bottom: 30px; background: #f8f9fa; padding: 20px; border-radius: 8px; }
        .section-title { font-size: 1.2em; font-weight: bold; margin-bottom: 15px; color: #495057; }
        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .detail-item { display: flex; margin-bottom: 10px; }
        .detail-label { font-weight: bold; min-width: 150px; color: #6c757d; }
        .detail-value { flex: 1; }
        
        .status-badge { padding: 6px 12px; border-radius: 4px; font-weight: bold; display: inline-block; }
        .status-reported { background: #ffc107; color: #000; }
        .status-confirmed { background: #17a2b8; color: #fff; }
        .status-adjusted { background: #fd7e14; color: #fff; }
        .status-settled { background: #28a745; color: #fff; }
        
        .table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table th, .table td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        .table th { background: #f8f9fa; font-weight: bold; }
        .table tr:hover { background: #f8f9fa; }
        
        .summary-section { background: #e9ecef; padding: 20px; border-radius: 8px; margin-top: 20px; }
        .summary-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 1.1em; }
        .summary-label { font-weight: bold; }
        .total-row { border-top: 2px solid #dee2e6; padding-top: 10px; margin-top: 10px; }
        .total-row .summary-value { color: #28a745; font-size: 1.3em; font-weight: bold; }
        
        .notes-section { background: #f8f9fa; padding: 15px; border-radius: 4px; margin-top: 20px; }
        .notes-label { font-weight: bold; margin-bottom: 5px; }
        .notes-content { white-space: pre-wrap; }
        
        @media (max-width: 768px) {
            .detail-grid { grid-template-columns: 1fr; }
            .actions .btn { display: block; width: 100%; margin-bottom: 10px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><%= title %></h1>
        </div>

        <div class="actions">
            <a href="/consignments/<%= consignment.id %>/reports" class="btn btn-secondary">
                ← 販売報告一覧
            </a>
            <% if (salesReport.status === 'reported') { %>
                <button class="btn btn-success" onclick="confirmSales()">確認する</button>
            <% } %>
            <% if (['confirmed', 'adjusted'].includes(salesReport.status)) { %>
                <button class="btn btn-warning" onclick="adjustSales()">調整する</button>
                <button class="btn btn-primary" onclick="settleSales()">精算する</button>
            <% } %>
        </div>

        <!-- 基本情報 -->
        <div class="detail-section">
            <div class="section-title">販売報告情報</div>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">報告期間:</span>
                    <span class="detail-value">
                        <%= new Date(salesReport.reportPeriodStart).toLocaleDateString('ja-JP') %> 〜
                        <%= new Date(salesReport.reportPeriodEnd).toLocaleDateString('ja-JP') %>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">ステータス:</span>
                    <span class="detail-value">
                        <span class="status-badge status-<%= salesReport.status %>">
                            <%= salesReport.statusText %>
                        </span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">報告日時:</span>
                    <span class="detail-value">
                        <%= new Date(salesReport.reportedAt).toLocaleString('ja-JP') %>
                    </span>
                </div>
                <% if (salesReport.confirmedAt) { %>
                <div class="detail-item">
                    <span class="detail-label">確認日時:</span>
                    <span class="detail-value">
                        <%= new Date(salesReport.confirmedAt).toLocaleString('ja-JP') %>
                    </span>
                </div>
                <% } %>
                <% if (salesReport.adjustedAt) { %>
                <div class="detail-item">
                    <span class="detail-label">調整日時:</span>
                    <span class="detail-value">
                        <%= new Date(salesReport.adjustedAt).toLocaleString('ja-JP') %>
                    </span>
                </div>
                <% } %>
                <% if (salesReport.settledAt) { %>
                <div class="detail-item">
                    <span class="detail-label">精算日時:</span>
                    <span class="detail-value">
                        <%= new Date(salesReport.settledAt).toLocaleString('ja-JP') %>
                    </span>
                </div>
                <% } %>
                <% if (salesReport.settlementMethod) { %>
                <div class="detail-item">
                    <span class="detail-label">精算方法:</span>
                    <span class="detail-value"><%= salesReport.settlementMethod %></span>
                </div>
                <% } %>
            </div>
        </div>

        <!-- 販売明細 -->
        <% if (salesReport.details && salesReport.details.length > 0) { %>
        <div class="detail-section">
            <div class="section-title">販売明細</div>
            <table class="table">
                <thead>
                    <tr>
                        <th>書籍名</th>
                        <th>版</th>
                        <th>数量</th>
                        <th>単価</th>
                        <th>小計</th>
                    </tr>
                </thead>
                <tbody>
                    <% salesReport.details.forEach(detail => { %>
                    <tr>
                        <td><%= detail.bookTitle %></td>
                        <td><%= detail.editionName %></td>
                        <td><%= detail.quantity %></td>
                        <td>¥<%= detail.unitPrice.toLocaleString() %></td>
                        <td>¥<%= detail.subtotal.toLocaleString() %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>

        <!-- 金額サマリー -->
        <div class="summary-section">
            <div class="summary-row">
                <span class="summary-label">総売上金額:</span>
                <span class="summary-value">¥<%= salesReport.totalSalesAmount.toLocaleString() %></span>
            </div>
            <div class="summary-row">
                <span class="summary-label">手数料 (<%= consignment.commissionRate %>%):</span>
                <span class="summary-value">¥<%= salesReport.commissionAmount.toLocaleString() %></span>
            </div>
            <div class="summary-row total-row">
                <span class="summary-label">純額:</span>
                <span class="summary-value">¥<%= salesReport.netAmount.toLocaleString() %></span>
            </div>
        </div>

        <!-- 調整理由 -->
        <% if (salesReport.adjustmentReason) { %>
        <div class="notes-section">
            <div class="notes-label">調整理由:</div>
            <div class="notes-content"><%= salesReport.adjustmentReason %></div>
        </div>
        <% } %>

        <!-- 備考 -->
        <% if (salesReport.notes) { %>
        <div class="notes-section">
            <div class="notes-label">備考:</div>
            <div class="notes-content"><%= salesReport.notes %></div>
        </div>
        <% } %>
    </div>

    <script>
        function confirmSales() {
            const notes = prompt('確認コメントを入力してください（任意）:')
            if (notes !== null) {
                const form = document.createElement('form')
                form.method = 'POST'
                form.action = `/consignments/<%= consignment.id %>/reports/<%= salesReport.id %>/confirm`
                
                const notesInput = document.createElement('input')
                notesInput.type = 'hidden'
                notesInput.name = 'notes'
                notesInput.value = notes
                form.appendChild(notesInput)
                
                document.body.appendChild(form)
                form.submit()
            }
        }

        function adjustSales() {
            const reason = prompt('調整理由を入力してください:')
            if (reason) {
                const adjustedAmount = prompt('調整後金額を入力してください（空白の場合は金額変更なし）:')
                
                const form = document.createElement('form')
                form.method = 'POST'
                form.action = `/consignments/<%= consignment.id %>/reports/<%= salesReport.id %>/adjust`
                
                const reasonInput = document.createElement('input')
                reasonInput.type = 'hidden'
                reasonInput.name = 'adjustmentReason'
                reasonInput.value = reason
                form.appendChild(reasonInput)
                
                if (adjustedAmount && !isNaN(adjustedAmount)) {
                    const amountInput = document.createElement('input')
                    amountInput.type = 'hidden'
                    amountInput.name = 'adjustedSalesAmount'
                    amountInput.value = parseInt(adjustedAmount)
                    form.appendChild(amountInput)
                }
                
                document.body.appendChild(form)
                form.submit()
            }
        }

        function settleSales() {
            const method = prompt('精算方法を入力してください（bank_transfer, cash等）:', 'bank_transfer')
            if (method) {
                const notes = prompt('精算時のコメントを入力してください（任意）:')
                
                const form = document.createElement('form')
                form.method = 'POST'
                form.action = `/consignments/<%= consignment.id %>/reports/<%= salesReport.id %>/settle`
                
                const methodInput = document.createElement('input')
                methodInput.type = 'hidden'
                methodInput.name = 'settlementMethod'
                methodInput.value = method
                form.appendChild(methodInput)
                
                if (notes) {
                    const notesInput = document.createElement('input')
                    notesInput.type = 'hidden'
                    notesInput.name = 'notes'
                    notesInput.value = notes
                    form.appendChild(notesInput)
                }
                
                document.body.appendChild(form)
                form.submit()
            }
        }
    </script>
</body>
</html>