<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .header { margin-bottom: 20px; }
        .actions { margin-bottom: 20px; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; }
        .btn:hover { background: #0056b3; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .actions-cell { white-space: nowrap; }
        .action-link { margin-right: 8px; text-decoration: none; }
        .empty-message { text-align: center; padding: 40px; color: #666; }
        .badge { padding: 2px 6px; border-radius: 3px; font-size: 0.8em; }
        .badge-home { background-color: #e7f5ff; color: #1864ab; }
        .badge-warehouse { background-color: #fff3cd; color: #856404; }
        .badge-consignment { background-color: #f8d7da; color: #721c24; }
        .badge-event { background-color: #d4edda; color: #155724; }
    </style>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
    </div>

    <div class="actions">
        <a href="/storage-locations/new" class="btn">新規作成</a>
    </div>

    <% if (storageLocations.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>保管場所名</th>
                    <th>タイプ</th>
                    <th>委託販売</th>
                    <th>住所</th>
                    <th>備考</th>
                    <th>アクション</th>
                </tr>
            </thead>
            <tbody>
                <% storageLocations.forEach(location => { %>
                    <tr>
                        <td><%= location.name %></td>
                        <td>
                            <span class="badge badge-<%= location.type %>">
                                <%= location.typeDisplay %>
                            </span>
                        </td>
                        <td><%= location.isConsignment ? 'はい' : 'いいえ' %></td>
                        <td><%= location.address || '-' %></td>
                        <td title="<%= location.fullNotes %>"><%= location.notes %></td>
                        <td class="actions-cell">
                            <a href="/storage-locations/<%= location.id %>" class="action-link">詳細</a>
                            <a href="/storage-locations/<%= location.id %>/edit" class="action-link">編集</a>
                            <form style="display: inline;" method="POST" action="/storage-locations/<%= location.id %>" onsubmit="return confirm('本当に削除しますか？')">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" style="background: none; border: none; color: #dc3545; cursor: pointer; text-decoration: underline;">削除</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-message">
            <p>保管場所が登録されていません。</p>
            <a href="/storage-locations/new" class="btn">最初の保管場所を登録する</a>
        </div>
    <% } %>
</body>
</html>