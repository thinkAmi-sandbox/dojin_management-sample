<style>
    .exhibit-info { margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 4px; }
    .exhibit-info h2 { margin: 0; font-size: 18px; color: #333; }
    .exhibit-meta { margin-top: 8px; font-size: 14px; color: #666; }
    
    .form-group { margin-bottom: 20px; }
    .form-label { display: block; margin-bottom: 5px; font-weight: bold; color: #333; }
    .form-control { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 16px; }
    .form-control:focus { outline: none; border-color: #007bff; box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25); }
    .form-select { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 16px; background-color: white; }
    .form-text { font-size: 14px; color: #666; margin-top: 5px; }
    
    .error-message { color: #dc3545; font-size: 14px; margin-top: 5px; }
    .error .form-control { border-color: #dc3545; }
    
    .btn { display: inline-block; padding: 12px 24px; border: none; border-radius: 4px; font-size: 16px; text-decoration: none; cursor: pointer; text-align: center; }
    .btn-primary { background-color: #007bff; color: white; }
    .btn-primary:hover { background-color: #0056b3; }
    .btn-secondary { background-color: #6c757d; color: white; }
    .btn-secondary:hover { background-color: #545b62; }
    
    .form-actions { margin-top: 30px; display: flex; gap: 15px; }
    
    .book-preview { margin-top: 10px; padding: 10px; background-color: #f8f9fa; border-radius: 4px; font-size: 14px; color: #666; }
    
    /* レスポンシブ対応 */
    @media (max-width: 768px) {
        .form-actions { flex-direction: column; }
    }
</style>

<div class="page-header">
    <h1><%= title %></h1>
    <%- include('../shared/breadcrumbs', { breadcrumbs: breadcrumbs.map(b => ({ name: b.name, url: b.url, isLast: !b.url })) }) %>
</div>

    <div class="form-container">
            <div class="exhibit-info">
                <h2>出展申込情報</h2>
                <div class="exhibit-meta">
                    ステータス: <%= exhibit.status %> | 
                    スペース番号: <%= exhibit.spaceNumber %> | 
                    スペース種別: <%= exhibit.spaceType %>
                </div>
            </div>

            <% if (editions.length === 0) { %>
                <div style="text-align: center; padding: 40px; color: #666;">
                    <p style="font-size: 16px; margin-bottom: 20px;">
                        追加可能な版がありません
                    </p>
                    <p style="font-size: 14px; color: #999; margin-bottom: 20px;">
                        すべての版が既に追加されているか、現行版が登録されていません。
                    </p>
                    <a href="<%= backUrl %>" class="btn btn-secondary">戻る</a>
                </div>
            <% } else { %>
                <form method="POST" action="/exhibits/<%= exhibit.id %>/books">
                    <div class="form-group <%= errors.editionId ? 'error' : '' %>">
                        <label for="editionId" class="form-label">版選択 *</label>
                        <select 
                            id="editionId" 
                            name="editionId" 
                            class="form-select" 
                            required
                            onchange="updateEditionPreview()"
                        >
                            <option value="">版を選択してください</option>
                            <% editions.forEach(function(edition) { %>
                                <option 
                                    value="<%= edition.id %>"
                                    <%= formData.editionId == edition.id ? 'selected' : '' %>
                                    data-title="<%= edition.book.title %>"
                                    data-subtitle="<%= edition.book.subtitle %>"
                                    data-version="<%= edition.versionName %>"
                                    data-price="<%= edition.basePrice %>"
                                    data-pages="<%= edition.pageCount || '-' %>"
                                >
                                    <%= edition.displayText %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (errors.editionId) { %>
                            <div class="error-message"><%= errors.editionId %></div>
                        <% } %>
                        <div id="editionPreview" class="book-preview" style="display: none;">
                            <!-- 選択された版の詳細情報がここに表示される -->
                        </div>
                    </div>

                    <div class="form-group <%= errors.plannedQuantity ? 'error' : '' %>">
                        <label for="plannedQuantity" class="form-label">頒布予定数 *</label>
                        <input 
                            type="number" 
                            id="plannedQuantity" 
                            name="plannedQuantity" 
                            class="form-control" 
                            value="<%= formData.plannedQuantity %>"
                            min="0"
                            step="1"
                            required
                            onchange="updateRevenuePreview()"
                        >
                        <% if (errors.plannedQuantity) { %>
                            <div class="error-message"><%= errors.plannedQuantity %></div>
                        <% } %>
                        <div class="form-text">何冊頒布する予定ですか？</div>
                    </div>

                    <div class="form-group <%= errors.actualQuantity ? 'error' : '' %>">
                        <label for="actualQuantity" class="form-label">実際持込数</label>
                        <input 
                            type="number" 
                            id="actualQuantity" 
                            name="actualQuantity" 
                            class="form-control" 
                            value="<%= formData.actualQuantity %>"
                            min="0"
                            step="1"
                        >
                        <% if (errors.actualQuantity) { %>
                            <div class="error-message"><%= errors.actualQuantity %></div>
                        <% } %>
                        <div class="form-text">イベント当日の実際の持ち込み数</div>
                    </div>

                    <div class="form-group <%= errors.soldQuantity ? 'error' : '' %>">
                        <label for="soldQuantity" class="form-label">売上数</label>
                        <input 
                            type="number" 
                            id="soldQuantity" 
                            name="soldQuantity" 
                            class="form-control" 
                            value="<%= formData.soldQuantity %>"
                            min="0"
                            step="1"
                        >
                        <% if (errors.soldQuantity) { %>
                            <div class="error-message"><%= errors.soldQuantity %></div>
                        <% } %>
                        <div class="form-text">実際に販売した数</div>
                    </div>

                    <div class="form-group <%= errors.price ? 'error' : '' %>">
                        <label for="price" class="form-label">販売価格 *</label>
                        <input 
                            type="number" 
                            id="price" 
                            name="price" 
                            class="form-control" 
                            value="<%= formData.price %>"
                            min="0"
                            step="1"
                            required
                            onchange="updateRevenuePreview()"
                        >
                        <% if (errors.price) { %>
                            <div class="error-message"><%= errors.price %></div>
                        <% } %>
                        <div class="form-text">円（実際の販売価格・税込）</div>
                    </div>

                    <div class="form-group <%= errors.displayOrder ? 'error' : '' %>">
                        <label for="displayOrder" class="form-label">表示順序</label>
                        <input 
                            type="number" 
                            id="displayOrder" 
                            name="displayOrder" 
                            class="form-control" 
                            value="<%= formData.displayOrder %>"
                            min="0"
                            step="1"
                        >
                        <% if (errors.displayOrder) { %>
                            <div class="error-message"><%= errors.displayOrder %></div>
                        <% } %>
                        <div class="form-text">空欄の場合は自動で設定されます</div>
                    </div>

                    <div id="revenuePreview" class="book-preview" style="display: none;">
                        <strong>予想売上: </strong><span id="revenueAmount">¥0</span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">書籍を追加</button>
                        <a href="<%= backUrl %>" class="btn btn-secondary">キャンセル</a>
                    </div>
                </form>
            <% } %>
    </div>

<script>
    function updateEditionPreview() {
        const select = document.getElementById('editionId');
        const preview = document.getElementById('editionPreview');
        const selectedOption = select.options[select.selectedIndex];
        const priceInput = document.getElementById('price');
        
        if (selectedOption.value) {
            const title = selectedOption.dataset.title;
            const subtitle = selectedOption.dataset.subtitle;
            const version = selectedOption.dataset.version;
            const basePrice = selectedOption.dataset.price;
            const pages = selectedOption.dataset.pages;
            
            let previewHtml = `<strong>${title}</strong> - ${version}`;
            if (subtitle) {
                previewHtml += `<br><em>${subtitle}</em>`;
            }
            previewHtml += `<br>定価: ¥${parseInt(basePrice).toLocaleString('ja-JP')}`;
            previewHtml += `<br>ページ数: ${pages}ページ`;
            
            // 定価を販売価格のデフォルト値として設定（新規作成時のみ）
            if (!priceInput.value && basePrice) {
                priceInput.value = basePrice;
                updateRevenuePreview();
            }
            
            preview.innerHTML = previewHtml;
            preview.style.display = 'block';
        } else {
            preview.style.display = 'none';
        }
    }

    function updateRevenuePreview() {
        const quantity = parseInt(document.getElementById('plannedQuantity').value) || 0;
        const price = parseInt(document.getElementById('price').value) || 0;
        const soldQuantity = parseInt(document.getElementById('soldQuantity').value) || 0;
        
        const plannedRevenue = quantity * price;
        const actualRevenue = soldQuantity * price;
        
        const revenuePreview = document.getElementById('revenuePreview');
        const revenueAmount = document.getElementById('revenueAmount');
        
        if (quantity > 0 && price > 0) {
            let revenueText = `¥${plannedRevenue.toLocaleString('ja-JP')}`;
            if (soldQuantity > 0) {
                revenueText += ` (実売上: ¥${actualRevenue.toLocaleString('ja-JP')})`;
            }
            revenueAmount.innerHTML = revenueText;
            revenuePreview.style.display = 'block';
        } else {
            revenuePreview.style.display = 'none';
        }
    }

    // 初期表示時に実行
    document.addEventListener('DOMContentLoaded', function() {
        updateEditionPreview();
        updateRevenuePreview();
    });
</script>