<style>
    .header { margin-bottom: 20px; }
    .actions { margin-bottom: 20px; }
    .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; }
    .btn:hover { background: #0056b3; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background-color: #f2f2f2; }
    .actions-cell { white-space: nowrap; }
    .action-link { margin-right: 8px; text-decoration: none; }
    .empty-message { text-align: center; padding: 40px; color: #666; }
    .date-cell { white-space: nowrap; }
    .status-applied { color: #007bff; }
    .status-accepted { color: #28a745; font-weight: bold; }
    .status-rejected { color: #dc3545; }
    .status-cancelled { color: #6c757d; }

    /* レスポンシブ対応 */
    @media (max-width: 768px) {
        table { font-size: 12px; }
        th, td { padding: 4px; }
        .action-link { font-size: 11px; }
    }
</style>

<div class="header">
    <h1><%= title %></h1>
</div>

<div class="actions">
    <a href="/exhibits/new" class="btn">新規申込</a>
</div>

<% if (exhibits.length > 0) { %>
    <table>
        <thead>
            <tr>
                <th>イベント</th>
                <th>サークル</th>
                <th>ステータス</th>
                <th>スペース</th>
                <th>申込日</th>
                <th>結果日</th>
                <th>備考</th>
                <th>アクション</th>
            </tr>
        </thead>
        <tbody>
            <% exhibits.forEach(exhibit => { %>
                <tr>
                    <td>
                        <strong><%= exhibit.event.name %></strong><br>
                        <small><%= exhibit.event.formattedEventDate %> (<%= exhibit.event.venue %>)</small>
                    </td>
                    <td>
                        <strong><%= exhibit.circle.name %></strong><br>
                        <small><%= exhibit.circle.representativeName %></small>
                    </td>
                    <td class="status-<%= exhibit.status %>">
                        <%= exhibit.statusText %>
                    </td>
                    <td>
                        <%= exhibit.spaceNumber %><br>
                        <small><%= exhibit.spaceType %></small>
                    </td>
                    <td class="date-cell"><%= exhibit.formattedApplicationDate %></td>
                    <td class="date-cell"><%= exhibit.formattedResultDate %></td>
                    <td title="<%= exhibit.applicationNotes %>"><%= exhibit.applicationNotes %></td>
                    <td class="actions-cell">
                        <a href="/exhibits/<%= exhibit.id %>" class="action-link">詳細</a>
                        <a href="/exhibits/<%= exhibit.id %>/edit" class="action-link">編集</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <div class="empty-message">
        <p>出展申込が登録されていません</p>
        <a href="/exhibits/new" class="btn">新規申込</a>
    </div>
<% } %>