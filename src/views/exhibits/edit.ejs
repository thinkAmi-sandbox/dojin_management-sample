<style>
    .header { margin-bottom: 20px; }
    .form-container { max-width: 600px; margin: 0 auto; background: #f8f9fa; padding: 30px; border-radius: 8px; }
    .form-group { margin-bottom: 20px; }
    .form-label { display: block; margin-bottom: 5px; font-weight: bold; }
    .form-control { width: 100%; padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
    .form-control:focus { border-color: #007bff; outline: none; box-shadow: 0 0 0 2px rgba(0,123,255,0.25); }
    .form-actions { display: flex; gap: 10px; margin-top: 30px; }
    .btn { padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; }
    .btn-primary { background: #007bff; color: white; }
    .btn-primary:hover { background: #0056b3; }
    .btn-secondary { background: #6c757d; color: white; }
    .btn-secondary:hover { background: #5a6268; }
    .required { color: #dc3545; }
    .help-text { font-size: 12px; color: #6c757d; margin-top: 5px; }

    @media (max-width: 768px) {
        .form-container { padding: 20px; margin: 0 10px; }
        .form-actions { flex-direction: column; }
    }
</style>

<div class="header">
    <h1><%= title %></h1>
</div>

<div class="form-container">
    <form method="POST" action="/exhibits/<%= exhibit.id %>">
        <input type="hidden" name="_method" value="PUT">

        <!-- イベント選択 -->
        <div class="form-group">
            <label for="eventId" class="form-label">イベント <span class="required">*</span></label>
            <select name="eventId" id="eventId" class="form-control" required>
                <option value="">-- イベントを選択してください --</option>
                <% events.forEach(event => { %>
                    <option value="<%= event.id %>" <%= event.id === exhibit.eventId ? 'selected' : '' %>>
                        <%= event.name %>
                    </option>
                <% }) %>
            </select>
            <div class="help-text">出展申込を行うイベントを選択してください</div>
        </div>

        <!-- サークル選択 -->
        <div class="form-group">
            <label for="circleId" class="form-label">サークル <span class="required">*</span></label>
            <select name="circleId" id="circleId" class="form-control" required>
                <option value="">-- サークルを選択してください --</option>
                <% circles.forEach(circle => { %>
                    <option value="<%= circle.id %>" <%= circle.id === exhibit.circleId ? 'selected' : '' %>>
                        <%= circle.name %>
                    </option>
                <% }) %>
            </select>
            <div class="help-text">申込を行うサークルを選択してください</div>
        </div>

        <!-- ステータス -->
        <div class="form-group">
            <label for="status" class="form-label">ステータス</label>
            <select name="status" id="status" class="form-control">
                <option value="applied" <%= exhibit.status === 'applied' ? 'selected' : '' %>>申込済み</option>
                <option value="accepted" <%= exhibit.status === 'accepted' ? 'selected' : '' %>>当選</option>
                <option value="rejected" <%= exhibit.status === 'rejected' ? 'selected' : '' %>>落選</option>
                <option value="cancelled" <%= exhibit.status === 'cancelled' ? 'selected' : '' %>>キャンセル</option>
            </select>
            <div class="help-text">抽選結果に応じてステータスを更新してください</div>
        </div>

        <!-- スペース情報 -->
        <div class="form-group">
            <label for="spaceNumber" class="form-label">スペース番号</label>
            <input type="text" name="spaceNumber" id="spaceNumber" class="form-control" 
                   value="<%= exhibit.spaceNumber || '' %>" placeholder="例: A-01, 西1ホール-あ12a">
            <div class="help-text">割り当てられたスペース番号（当選後に入力）</div>
        </div>

        <div class="form-group">
            <label for="spaceType" class="form-label">スペース種別</label>
            <input type="text" name="spaceType" id="spaceType" class="form-control" 
                   value="<%= exhibit.spaceType || '' %>" placeholder="例: 一般、企業、壁">
            <div class="help-text">スペースの種別（一般、企業、壁など）</div>
        </div>

        <!-- 申込備考 -->
        <div class="form-group">
            <label for="applicationNotes" class="form-label">申込備考</label>
            <textarea name="applicationNotes" id="applicationNotes" class="form-control" rows="4" 
                      placeholder="申込時のメモや特記事項があれば記入してください"><%= exhibit.applicationNotes || '' %></textarea>
            <div class="help-text">申込時の特記事項やメモを記録できます</div>
        </div>

        <!-- 結果備考 -->
        <div class="form-group">
            <label for="resultNotes" class="form-label">結果備考</label>
            <textarea name="resultNotes" id="resultNotes" class="form-control" rows="4" 
                      placeholder="抽選結果や当選後の連絡事項があれば記入してください"><%= exhibit.resultNotes || '' %></textarea>
            <div class="help-text">抽選結果発表後のメモや連絡事項を記録できます</div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">更新する</button>
            <a href="/exhibits/<%= exhibit.id %>" class="btn btn-secondary">詳細に戻る</a>
            <a href="/exhibits" class="btn btn-secondary">一覧に戻る</a>
        </div>
    </form>
</div>