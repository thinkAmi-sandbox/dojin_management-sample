<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; line-height: 1.6; }
        .header { margin-bottom: 20px; }
        .breadcrumb { margin-bottom: 15px; color: #666; }
        .breadcrumb a { color: #007bff; text-decoration: none; }
        .breadcrumb a:hover { text-decoration: underline; }
        
        .book-info { 
            background: #e9ecef; 
            padding: 15px; 
            border-radius: 8px; 
            margin-bottom: 20px; 
        }
        .book-title { font-size: 1.1em; font-weight: bold; }
        
        .form-container { 
            background: #f8f9fa; 
            padding: 20px; 
            border-radius: 8px; 
            max-width: 800px; 
        }
        .form-section { 
            margin-bottom: 25px; 
        }
        .section-title { 
            font-size: 1.1em; 
            font-weight: bold; 
            margin-bottom: 15px; 
            color: #495057;
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 5px;
        }
        .form-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 15px; 
        }
        .form-group { 
            margin-bottom: 15px; 
        }
        .form-group-full { 
            grid-column: 1 / -1; 
        }
        
        label { 
            display: block; 
            margin-bottom: 5px; 
            font-weight: bold; 
            color: #495057;
        }
        .required { color: #dc3545; }
        
        input[type="text"], 
        input[type="number"], 
        input[type="date"], 
        textarea, 
        select {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 1em;
            box-sizing: border-box;
        }
        
        input:focus, 
        textarea:focus, 
        select:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
        }
        
        textarea { 
            resize: vertical; 
            min-height: 80px; 
        }
        
        .checkbox-group { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
        }
        .checkbox-group input[type="checkbox"] { 
            width: auto; 
            margin: 0; 
        }
        
        .form-actions { 
            margin-top: 30px; 
            text-align: center; 
            border-top: 1px solid #dee2e6; 
            padding-top: 20px; 
        }
        .btn { 
            padding: 10px 20px; 
            margin: 0 8px; 
            border: none; 
            border-radius: 4px; 
            cursor: pointer; 
            text-decoration: none; 
            display: inline-block; 
            font-size: 1em;
        }
        .btn-primary { 
            background: #007bff; 
            color: white; 
        }
        .btn-primary:hover { 
            background: #0056b3; 
        }
        .btn-secondary { 
            background: #6c757d; 
            color: white; 
        }
        .btn-secondary:hover { 
            background: #545b62; 
        }
        
        .help-text { 
            font-size: 0.9em; 
            color: #666; 
            margin-top: 3px; 
        }
        
        /* レスポンシブ対応 */
        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .form-container { padding: 15px; }
            .btn { margin-bottom: 8px; }
        }
    </style>
</head>
<body>
    <div class="breadcrumb">
        <a href="/books">書籍一覧</a> &gt; 
        <a href="/books/<%= book.id %>"><%= book.title %></a> &gt; 
        <a href="/books/<%= book.id %>/editions">版一覧</a> &gt; 
        新版作成
    </div>

    <div class="header">
        <h1><%= title %></h1>
    </div>

    <div class="book-info">
        <div class="book-title"><%= book.title %></div>
        <% if (book.subtitle) { %>
            <div><%= book.subtitle %></div>
        <% } %>
    </div>

    <div class="form-container">
        <form method="POST" action="/books/<%= book.id %>/editions">
            <!-- 基本情報セクション -->
            <div class="form-section">
                <div class="section-title">📖 基本情報</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="versionName">版名 <span class="required">*</span></label>
                        <input 
                            type="text" 
                            id="versionName" 
                            name="versionName" 
                            placeholder="初版、第2版、新装版など"
                            required>
                        <div class="help-text">例: 初版、第2版、新装版</div>
                    </div>
                    <div class="form-group">
                        <label for="versionNumber">版番号 <span class="required">*</span></label>
                        <input 
                            type="number" 
                            id="versionNumber" 
                            name="versionNumber" 
                            min="1" 
                            value="1"
                            required>
                        <div class="help-text">ソート用の数値（1以上）</div>
                    </div>
                    <div class="form-group">
                        <label for="basePrice">基本価格 <span class="required">*</span></label>
                        <input 
                            type="number" 
                            id="basePrice" 
                            name="basePrice" 
                            min="0" 
                            placeholder="1000"
                            required>
                        <div class="help-text">円単位で入力</div>
                    </div>
                    <div class="form-group">
                        <label for="pageCount">ページ数</label>
                        <input 
                            type="number" 
                            id="pageCount" 
                            name="pageCount" 
                            min="1" 
                            placeholder="100">
                    </div>
                    <div class="form-group">
                        <label for="publishDate">発行日</label>
                        <input 
                            type="date" 
                            id="publishDate" 
                            name="publishDate">
                    </div>
                    <div class="form-group">
                        <label for="printingCost">印刷原価</label>
                        <input 
                            type="number" 
                            id="printingCost" 
                            name="printingCost" 
                            min="0" 
                            placeholder="500">
                        <div class="help-text">円単位で入力</div>
                    </div>
                </div>
            </div>

            <!-- 詳細情報セクション -->
            <div class="form-section">
                <div class="section-title">📝 詳細情報</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="isbn">ISBN</label>
                        <input 
                            type="text" 
                            id="isbn" 
                            name="isbn" 
                            maxlength="13" 
                            placeholder="9784123456789">
                        <div class="help-text">13桁以内</div>
                    </div>
                    <div class="form-group">
                        <label for="coverImageUrl">表紙画像URL</label>
                        <input 
                            type="text" 
                            id="coverImageUrl" 
                            name="coverImageUrl" 
                            placeholder="https://example.com/cover.jpg">
                    </div>
                    <div class="form-group form-group-full">
                        <label for="editionNotes">版の詳細</label>
                        <textarea 
                            id="editionNotes" 
                            name="editionNotes" 
                            placeholder="改訂内容、追加要素、特記事項など"></textarea>
                        <div class="help-text">改訂内容、追加要素、特記事項など</div>
                    </div>
                </div>
            </div>

            <!-- ステータス設定セクション -->
            <div class="form-section">
                <div class="section-title">📊 ステータス設定</div>
                <div class="form-grid">
                    <div class="form-group">
                        <div class="checkbox-group">
                            <input 
                                type="checkbox" 
                                id="isActive" 
                                name="isActive" 
                                value="true" 
                                checked>
                            <label for="isActive">現行版として設定</label>
                        </div>
                        <div class="help-text">最新の販売版として扱う場合にチェック</div>
                    </div>
                    <div class="form-group">
                        <div class="checkbox-group">
                            <input 
                                type="checkbox" 
                                id="isSoldOut" 
                                name="isSoldOut" 
                                value="true">
                            <label for="isSoldOut">完売フラグ</label>
                        </div>
                        <div class="help-text">在庫切れの場合にチェック</div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">版を作成</button>
                <a href="/books/<%= book.id %>/editions" class="btn btn-secondary">キャンセル</a>
            </div>
        </form>
    </div>
</body>
</html>