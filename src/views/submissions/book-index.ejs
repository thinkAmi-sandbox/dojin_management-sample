<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .header { margin-bottom: 20px; }
        .book-info { background: #f8f9fa; padding: 15px; border-radius: 5px; margin-bottom: 20px; }
        .book-title { font-size: 1.2em; font-weight: bold; margin-bottom: 5px; }
        .book-subtitle { color: #666; margin-bottom: 10px; }
        .actions { margin-bottom: 20px; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; margin-right: 10px; }
        .btn:hover { background: #0056b3; }
        .btn-secondary { background: #6c757d; }
        .btn-secondary:hover { background: #545b62; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .actions-cell { white-space: nowrap; }
        .action-link { margin-right: 8px; text-decoration: none; }
        .empty-message { text-align: center; padding: 40px; color: #666; }
        .status-draft { color: #6c757d; }
        .status-submitted { color: #007bff; }
        .status-printing { color: #fd7e14; }
        .status-delivered { color: #28a745; }
        .book-title-cell { font-weight: bold; }
        .book-subtitle-cell { font-size: 0.9em; color: #666; }
    </style>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
    </div>

    <div class="book-info">
        <div class="book-title"><%= book.title %></div>
        <% if (book.subtitle) { %>
            <div class="book-subtitle"><%= book.subtitle %></div>
        <% } %>
    </div>

    <div class="actions">
        <a href="/books/<%= book.id %>/submissions/new" class="btn">新規入稿作成</a>
        <a href="/submissions" class="btn btn-secondary">全入稿一覧</a>
        <a href="/books/<%= book.id %>" class="btn btn-secondary">書籍詳細に戻る</a>
    </div>

    <% if (submissions.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>印刷所</th>
                    <th>ステータス</th>
                    <th>部数</th>
                    <th>搬入先</th>
                    <th>作成日</th>
                    <th>アクション</th>
                </tr>
            </thead>
            <tbody>
                <% submissions.forEach(submission => { %>
                    <tr>
                        <td><%= submission.printingCompanyName %></td>
                        <td>
                            <span class="status-<%= submission.status.includes('準備中') ? 'draft' : 
                                                    submission.status.includes('入稿済み') ? 'submitted' : 
                                                    submission.status.includes('印刷中') ? 'printing' : 
                                                    submission.status.includes('納品済み') ? 'delivered' : 'draft' %>">
                                <%= submission.status %>
                            </span>
                        </td>
                        <td><%= submission.quantity %>部</td>
                        <td><%= submission.deliveryDestination %></td>
                        <td><%= submission.formattedCreatedAt %></td>
                        <td class="actions-cell">
                            <a href="<%= submission.detailUrl %>" class="action-link">詳細</a>
                            <a href="<%= submission.editUrl %>" class="action-link">編集</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-message">
            <p>この書籍の入稿履歴はありません。</p>
            <a href="/books/<%= book.id %>/submissions/new" class="btn">新規入稿を作成する</a>
        </div>
    <% } %>
</body>
</html>