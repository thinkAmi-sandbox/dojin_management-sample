<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; }
        .header { margin-bottom: 20px; }
        .actions { margin-bottom: 20px; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; }
        .btn:hover { background: #0056b3; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .actions-cell { white-space: nowrap; }
        .action-link { margin-right: 8px; text-decoration: none; }
        .empty-message { text-align: center; padding: 40px; color: #666; }
        .status-draft { color: #6c757d; }
        .status-submitted { color: #007bff; }
        .status-printing { color: #fd7e14; }
        .status-delivered { color: #28a745; }
        .book-title { font-weight: bold; }
        .book-subtitle { font-size: 0.9em; color: #666; }
    </style>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
    </div>

    <!-- サブナビゲーション -->
    <div class="sub-navigation" style="margin-bottom: 20px; border-bottom: 1px solid #ddd;">
        <a href="/submissions" class="tab active" style="display: inline-block; padding: 10px 16px; text-decoration: none; color: #007bff; border-bottom: 2px solid #007bff; margin-right: 20px;">全て</a>
        <a href="/submissions/in-progress" class="tab" style="display: inline-block; padding: 10px 16px; text-decoration: none; color: #666; border-bottom: 2px solid transparent; margin-right: 20px; transition: color 0.2s, border-color 0.2s;" onmouseover="this.style.color='#007bff'" onmouseout="this.style.color='#666'">進行中のみ</a>
        <a href="/submissions/costs" class="tab" style="display: inline-block; padding: 10px 16px; text-decoration: none; color: #666; border-bottom: 2px solid transparent; margin-right: 20px; transition: color 0.2s, border-color 0.2s;" onmouseover="this.style.color='#007bff'" onmouseout="this.style.color='#666'">コスト集計</a>
    </div>

    <div class="actions">
        <a href="/books" class="btn">書籍一覧から入稿作成</a>
    </div>

    <% if (submissions.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>書籍名</th>
                    <th>印刷所</th>
                    <th>ステータス</th>
                    <th>部数</th>
                    <th>搬入先</th>
                    <th>作成日</th>
                    <th>アクション</th>
                </tr>
            </thead>
            <tbody>
                <% submissions.forEach(submission => { %>
                    <tr>
                        <td>
                            <div class="book-title"><%= submission.bookTitle %></div>
                            <% if (submission.bookSubtitle) { %>
                                <div class="book-subtitle"><%= submission.bookSubtitle %></div>
                            <% } %>
                        </td>
                        <td><%= submission.printingCompanyName %></td>
                        <td>
                            <span class="status-<%= submission.status.includes('準備中') ? 'draft' : 
                                                    submission.status.includes('入稿済み') ? 'submitted' : 
                                                    submission.status.includes('印刷中') ? 'printing' : 
                                                    submission.status.includes('納品済み') ? 'delivered' : 'draft' %>">
                                <%= submission.status %>
                            </span>
                        </td>
                        <td><%= submission.quantity %>部</td>
                        <td><%= submission.deliveryDestination %></td>
                        <td><%= submission.formattedCreatedAt %></td>
                        <td class="actions-cell">
                            <a href="<%= submission.detailUrl %>" class="action-link">詳細</a>
                            <a href="<%= submission.editUrl %>" class="action-link">編集</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-message">
            <p>入稿データが登録されていません。</p>
            <a href="/books" class="btn">書籍一覧から入稿を作成する</a>
        </div>
    <% } %>
</body>
</html>