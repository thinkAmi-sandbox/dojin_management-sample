<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { font-family: sans-serif; margin: 20px; line-height: 1.6; }
        .header { margin-bottom: 20px; }
        .breadcrumbs { margin-bottom: 20px; color: #666; }
        .breadcrumbs a { color: #007bff; text-decoration: none; }
        .breadcrumbs a:hover { text-decoration: underline; }
        .btn { background: #007bff; color: white; padding: 8px 16px; text-decoration: none; border-radius: 4px; margin-right: 8px; border: none; cursor: pointer; }
        .btn:hover { background: #0056b3; }
        .btn-secondary { background: #6c757d; }
        .btn-secondary:hover { background: #545b62; }
        .info-box { background: #e7f3ff; border: 1px solid #b6d7ff; padding: 15px; border-radius: 8px; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .stock-number { text-align: right; font-weight: bold; }
    </style>
</head>
<body>
    <div class="breadcrumbs">
        <a href="/stocks">在庫一覧</a> &gt; 
        <span>棚卸し</span>
    </div>

    <div class="header">
        <h1><%= title %></h1>
    </div>

    <div class="info-box">
        <strong>📋 棚卸し機能</strong><br>
        こちらは現在の在庫一覧です。将来的に一括棚卸し機能を実装予定です。
    </div>

    <div style="margin-bottom: 20px;">
        <a href="/stocks" class="btn btn-secondary">一覧に戻る</a>
    </div>

    <% if (stocks.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>版</th>
                    <th>保管場所</th>
                    <th>総在庫数</th>
                    <th>予約済み</th>
                    <th>販売可能</th>
                </tr>
            </thead>
            <tbody>
                <% stocks.forEach(stock => { %>
                    <tr>
                        <td><%= stock.editionName %></td>
                        <td><%= stock.locationName %></td>
                        <td class="stock-number"><%= stock.quantity %></td>
                        <td class="stock-number"><%= stock.reservedQuantity %></td>
                        <td class="stock-number"><%= stock.availableQuantity %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div style="text-align: center; padding: 40px; color: #666;">
            <p>在庫データが登録されていません。</p>
        </div>
    <% } %>
</body>
</html>
